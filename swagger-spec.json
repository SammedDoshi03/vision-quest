    "/medical/pairing": {
      "post": {
        "operationId": "MedicalController_pairPatient",
        "summary": "Pair patient with caregiver using Login ID and 4-digit PIN",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "patientLoginId": {
                    "type": "string",
                    "example": "AAJI101"
                  },
                  "pin": {
                    "type": "string",
                    "example": "1234"
                  },
                  "caregiverUid": {
                    "type": "string",
                    "example": "cg_202"
                  }
                },
                "required": [
                  "patientLoginId",
                  "pin",
                  "caregiverUid"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
