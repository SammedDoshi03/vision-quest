{
  "name": "resonance-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-native": "^0.76.1"
    }
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "tsx": "^4.23.15",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
