    "/medical/patients/{patientId}/schedules": {
      "get": {
        "operationId": "MedicalController_getTodaySchedules",
        "summary": "Get patient's medication schedule for today",
        "parameters": [
          {
            "name": "patientId",
            "required": true,
            "in": "path",
            "description": "Unique patient identifier (e.g. pt_101)",
