# ==============================================================================
# GLOBAL RUNTIME ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Service Data Source Mode: 'mock' | 'firebase' | 'postgres'
ACTIVE_DATA_SOURCE=mock

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_secure_pass
DATABASE_NAME=resonance_db
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT_SECONDS=300

# Firebase Realtime Database (Medical Adherence Domain)
FIREBASE_PROJECT_ID=healthcare-companion-dev
FIREBASE_DATABASE_URL=https://healthcare-companion-dev-default-rtdb.firebaseio.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@healthcare-companion-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & Secrets
JWT_ACCESS_SECRET=dev_jwt_access_super_secret_key_change_in_prod_123456789
JWT_REFRESH_SECRET=dev_jwt_refresh_super_secret_key_change_in_prod_987654321
CORS_ORIGIN=*
